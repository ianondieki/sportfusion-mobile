{
  "expo": {
    "name": "SportsFusion",
    "slug": "sportsfusion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sportsfusion",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A0F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.nyamunga.sportsfusionmobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SportsFusion uses the microphone so you can talk to APEX.",
          "speechRecognitionPermission": "SportsFusion uses speech recognition to turn your voice into chat messages."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa66ea70-6852-4a11-b12a-ebcd1e8d74bc"
      }
    }
  }
}
