{
  "expo": {
    "name": "SportsFusion",
    "slug": "sportsfusion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sportsfusion",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0A0A0F",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
